# =============================================================================
# Backend environment template
# Copy this file to backend/.env and fill in real values:
#   PowerShell :  copy backend\.env.example backend\.env
#   bash/zsh   :  cp backend/.env.example backend/.env
#
# backend/.env is git-ignored - never commit real credentials. Keys below are
# every variable the Express/Socket.IO server reads at runtime; the server
# refuses to start without MONGO_URI and throws at call time for the Razorpay
# and SMTP groups.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Port for the Express + Socket.IO HTTP server (src/server.js)
PORT=5000
# development | production - in production auth cookies are flagged Secure
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# Local MongoDB or an Atlas SRV string (src/config/db.js, scripts/seed-demo-event.js)
MONGO_URI=mongodb://127.0.0.1:27017/event-ticketing-engine

# --- CORS / client origin ----------------------------------------------------
# Origin allowed to call the REST API and open the Socket.IO connection
# (src/app.js, src/socket.js). Must match the Vite dev server origin
# (vite.config.js uses 5173; 5173 and 5174 are both allowed as fallbacks).
FRONTEND_URL=http://localhost:5173

# --- Authentication ----------------------------------------------------------
# Long random secret, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Razorpay (payments) -----------------------------------------------------
# Dashboard > Settings > API Keys (use TEST keys while developing).
# RAZORPAY_KEY_ID is also returned to the browser by POST /api/bookings/checkout.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
# Dashboard > Settings > Webhooks > secret used to verify X-Razorpay-Signature
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# --- SMTP (ticket confirmation emails) ---------------------------------------
# Gmail requires a 16-character App Password, not the account password
# (src/services/email.service.js).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=TicketEngine <tickets@example.com>
