# =============================================================================
# Frontend environment template
# Copy this file to frontend/.env and adjust for your environment:
#   PowerShell :  copy frontend\.env.example frontend\.env
#   bash/zsh   :  cp frontend/.env.example frontend/.env
#
# frontend/.env is git-ignored. Vite only exposes VITE_* variables and inlines
# them into the client bundle, so NEVER put secrets here. The Razorpay checkout
# key is fetched from the backend at checkout time - no VITE_ key is required.
# =============================================================================

# Base URL of the Express REST API used by every axios request
# (src/services/api.js). Defaults to http://localhost:5000/api when unset.
VITE_API_BASE_URL=http://localhost:5000/api

# Origin of the Socket.IO server for real-time seat lock/book updates
# (src/context/SocketContext.jsx). Defaults to http://localhost:5000 when unset.
VITE_SOCKET_URL=http://localhost:5000

# Optional: override the Vite dev server port from vite.config.js (default 5173).
# Keep the backend FRONTEND_URL in sync with the port you use here.
# VITE_PORT=5173
